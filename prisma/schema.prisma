datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PM
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role
  createdAt     DateTime @default(now())

  projectsOwned Project[]      @relation("PMProjects")
  tasksAssigned Task[]         @relation("AssignedTasks")
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@index([role])
}

model Client {
  id       String    @id @default(uuid())
  name     String
  projects Project[]
}

model Project {
  id        String   @id @default(uuid())
  name      String
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  pmId      String
  pm        User     @relation("PMProjects", fields: [pmId], references: [id])
  createdAt DateTime @default(now())
  tasks     Task[]

  @@index([pmId])
  @@index([clientId])
}

model Task {
  id           String     @id @default(uuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id])
  title        String
  description  String?
  assigneeId   String?
  assignee     User?      @relation("AssignedTasks", fields: [assigneeId], references: [id])
  status       TaskStatus @default(TODO)
  priority     Priority   @default(MEDIUM)
  dueDate      DateTime?
  isOverdue    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  activityLogs ActivityLog[]
  notifications Notification[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

model ActivityLog {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  projectId String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fromStatus TaskStatus?
  toStatus   TaskStatus
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([taskId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}
